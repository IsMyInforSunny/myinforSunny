# Runtime secrets belong in the hosted server, never the browser or Git.
AI_PROVIDER=groq
FREE_ONLY=true
ENABLE_PAID_PROVIDER=false
PAID_ACTIVATION_CONFIRMED=false
ENABLE_LIVE_ANALYSIS=false
GROQ_API_KEY=
# Local preview only: optionally reference an existing key file without copying it.
# INFORCAST_GROQ_KEY_FILE=../.env.groq.local
# Initial implementation candidate; Korean quality has not been verified yet.
GROQ_MODEL=openai/gpt-oss-120b
# Set only after actual account eligibility, youth-app conditions, free plan and data controls review.
GROQ_ELIGIBILITY_CONFIRMED=false
GROQ_FREE_PLAN_CONFIRMED=false
DAILY_TOKEN_BUDGET=120000
# Future paid-provider implementation only; existing local key is not copied or read now.
# AI_PROVIDER=openai plus all explicit paid gates and verified model/budget are required.

# Do not guess console limits. Enable only after checking this account.
GROQ_CONSOLE_LIMITS_CONFIRMED=false
GROQ_CONSOLE_TPD=
GROQ_CONSOLE_RPD=
GROQ_CONSOLE_TPM=
GROQ_CONSOLE_RPM=
ENABLE_NEWS_SEARCH=false
ENABLE_DIRECT_FETCH=false
NEWS_PROVIDER=gdelt
NEWS_TERMS_APPROVED=false
ALLOWED_RETRIEVAL_HOSTS=
# Optional Firecrawl REST adapter. Never enable before account, source terms and actual costs are confirmed.
FIRECRAWL_API_KEY=
FIRECRAWL_TERMS_APPROVED=false
FIRECRAWL_SOURCE_TERMS_APPROVED=false
FIRECRAWL_FREE_PLAN_CONFIRMED=false
FIRECRAWL_CONSOLE_LIMITS_CONFIRMED=false
FIRECRAWL_CONSOLE_CREDITS=
FIRECRAWL_CREDIT_BUDGET=
FIRECRAWL_SEARCH_CREDIT_COST=
FIRECRAWL_SCRAPE_CREDIT_COST=
