{
  "version": "voice-features-1.0",
  "boilerplatePatterns": [
    "^(?:AD[0-9]*|#AD[0-9]+|광고|오탈자\\s*신고|기사\\s*제보|오류\\s*제보)$",
    "^(?:#[^\\s#]+)(?:\\s+#[^\\s#]+)*$",
    "^(?:©|ⓒ|저작권자(?:\\s|\\(|\\)|:)|Copyright(?:\\s*[:©ⓒ]|\\s+[0-9]{4}(?:\\s|[.©ⓒ]|$)))[\\s\\S]*$",
    "^무단\\s*(?:전재|복제)[\\s\\S]{0,100}금지[.!\\s]*$"
  ],
  "replacements": [
    ["핵\\s*발전소|원자력\\s*발전소", "원전"],
    ["핵\\s*발전|원자력\\s*발전", "원전"],
    ["[0-9]+(?:[.,][0-9]+)*", "0"],
    ["한겨레(?:신문)?|경향신문|한국일보|동아일보|중앙일보|조선일보|연합뉴스|전자신문|지디넷코리아", ""]
  ]
}
